# Copy to .env and select exactly one database configuration.
# MySQL is primary: mysql+pymysql://user:password@localhost/electricity_analysis
DATABASE_URL=

# Explicit local demo fallback. Used only when DATABASE_URL is blank.
SQLITE_PATH=instance/electricity_demo.db

FLASK_SECRET_KEY=replace-with-a-long-random-local-secret
HIGH_USAGE_THRESHOLD_KWH=120
LARGE_JUMP_MULTIPLIER=3
APP_ENV=development